{
  "name": "@zondax/ledger-kadena",
  "version": "0.0.1",
  "description": "Node API for the Kadena App (Ledger Nano S/X/S+)",
  "keywords": [
    "Zondax",
    "Ledger",
    "Typescript",
    "Javascript",
    "Kadena"
  ],
  "homepage": "https://github.com/zondax/ledger-kadena",
  "bugs": {
    "url": "https://github.com/zondax/ledger-kadena/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zondax/ledger-kadena.git"
  },
  "license": "Apache-2.0",
  "author": "Zondax AG",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typings": "./dist/index.d.ts",
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "tsc",
    "format": "FORCE_COLOR=1 prettier --write . && sort-package-json",
    "format:check": "FORCE_COLOR=1 prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "yarn build && jest",
    "upgrade": "bunx npm-check-updates -i"
  },
  "dependencies": {
    "@zondax/ledger-js": "^1.3.1",
    "blakejs": "^1.2.1"
  },
  "devDependencies": {
    "@ledgerhq/hw-transport-mocker": "^6.29.12",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/jest": "30.0.0",
    "@types/node": "^24.8.0",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-tsdoc": "^0.4.0",
    "eslint-plugin-unused-imports": "^4.2.0",
    "prettier": "^3.6.2",
    "sort-package-json": "^3.4.0",
    "ts-jest": "^29.4.5",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
